{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "summary"
        ]
      },
      "minItems": 1
    },
    "studies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "publication": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "doi": {
                "type": "string",
                "pattern": "^10\\.[0-9]{4,9}/\\S+$"
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "year": {
                "type": "integer",
                "minimum": 2000
              },
              "journal": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "doi",
              "authors",
              "year",
              "journal"
            ]
          },
          "contribution": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "data_lineage": {
            "type": "string",
            "minLength": 1
          },
          "editions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "historical",
                    "archived",
                    "maintained",
                    "example",
                    "unmapped"
                  ]
                },
                "source": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "repository": {
                          "type": "string",
                          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                        },
                        "commit": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        },
                        "entrypoint": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "repository",
                        "commit",
                        "entrypoint"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://"
                      }
                    },
                    "required": [
                      "label",
                      "url"
                    ]
                  },
                  "minItems": 0
                },
                "mario": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "limitations": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://"
                      }
                    },
                    "required": [
                      "label",
                      "url"
                    ]
                  },
                  "minItems": 0
                },
                "execution": {
                  "const": "not-run-by-gallery"
                }
              },
              "required": [
                "id",
                "label",
                "role",
                "source",
                "data",
                "mario",
                "scope",
                "limitations",
                "evidence",
                "execution"
              ]
            },
            "minItems": 1
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "family",
          "title",
          "summary",
          "publication",
          "contribution",
          "scope",
          "data_lineage",
          "editions",
          "related"
        ]
      },
      "minItems": 1
    },
    "foundations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "url"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "updated_at",
    "families",
    "studies",
    "foundations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
